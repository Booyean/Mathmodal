    "npz_energy_storage": "all image_*, slice_*, proj_*, shadow_profile_x_y arrays MUST store non-negative linear normalized energy (float64); convert to dB only during figure rendering",
    "plot_db_normalization": {
      "formula": "10 * log10(max(I, 1e-12 * I_ref) / I_ref)",
