    },
    "symbol_aliases": {
      "C_B/A": "Delta_B/A -> delta_ba_db",
      "C_B/bg": "PBR_B -> pbr_b_db"
    },
    "runtime_status_enum": [
      "contract_only",
      "synthetic_baseline_only",
      "empirical_pending_acceptance",
